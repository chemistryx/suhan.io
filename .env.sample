# Public: exposed to the browser
NEXT_PUBLIC_BASEURL=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Records: GitHub repo (owner/name) and a token with Contents read/write
CONTENT_REPO=""
GITHUB_TOKEN=""

# Sign-in: GitHub App, and a random string that signs the session cookie (openssl rand -base64 32)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
AUTH_SECRET=""

# Cloudflare: R2 for images, D1 for comments, and a token with D1 Edit
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
ASSETS_BASE_URL=""
D1_DATABASE_ID=""

# Comment notifications
RESEND_API_KEY=""

# Cloudflare Turnstile secret for anonymous comments; unset to skip the check
TURNSTILE_SECRET_KEY=""

# Signs Vercel cron requests
CRON_SECRET=""

# Optional
# AUTHOR_GITHUB_LOGIN=""       defaults to the owner of CONTENT_REPO
# MAIL_FROM=""                 defaults to noreply@<NEXT_PUBLIC_BASEURL host>
# MAIL_TO=""                   defaults to NEXT_PUBLIC_CONTACT_EMAIL
# GOOGLE_SITE_VERIFICATION=""
# NAVER_SITE_VERIFICATION=""
